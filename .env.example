# amazon-ads-mcp-server configuration. See the README.
# Never commit a filled-in copy of this file.

# Login with Amazon security profile of an application with Amazon Ads API access.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=

# Refresh token from the authorization grant, starting with Atzr|. The server
# renews access tokens in memory and never writes a token to disk.
AMAZON_ADS_REFRESH_TOKEN=

# API region of the profiles below: NA, EU or FE.
AMAZON_ADS_REGION=NA

# Required, even for reads: the advertising profile IDs this server may use,
# separated by commas. Every other profile is refused before any request.
AMAZON_ADS_PROFILE_IDS=

# Write tools are off by default. Only the exact value true exposes them.
# Every write still previews first and applies only on a second call with
# confirm: true and the previewToken.
AMAZON_ADS_ENABLE_WRITES=false
